#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Combo_CLR_BT {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <13 0>;
            layers = <1 0 2 3>;
        };
    };

    macros {
        commanding: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(K)>, <&macro_wait_time 100>, <&kp LC(C)>;

            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp ESC    &kp N1    &kp N2        &kp N3     &kp N4        &kp N5     &kp N6     &kp N7     &kp N8     &kp N9            &kp N0             &kp BSPC
&kp TAB    &kp Q     &kp W         &kp E      &kp R         &kp T      &kp Y      &kp U      &kp I      &kp O             &kp P              &kp BACKSLASH
&kp CAPS   &kp A     &kp S         &kp D      &kp F         &kp G      &kp H      &kp J      &kp K      &kp L             &kp SEMI           &kp SQT
&kp LSHFT  &kp Z     &kp X         &kp C      &kp V         &kp B      &kp N      &kp M      &kp COMMA  &kp DOT           &kp FSLH           &kp RET
&kp ENTER  &kp LGUI  &kp LEFT_ALT  &kp LCTRL  &lt 1 DELETE  &kp SPACE  &kp SPACE  &kp MINUS  &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp ENTER
           &kp LEFT  &kp UP        &none      &kp DOWN      &kp RIGHT  &kp LEFT   &kp DOWN   &none      &kp UP            &kp RIGHT
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_D_U>;
        };

        lower_layer {
            display-name = "Lower Layer";
            bindings = <
&kp GRAVE          &kp F1          &kp F2    &kp F3     &kp F4  &kp F5  &kp F6          &kp F7          &kp F8             &kp F9   &kp F10  &kp DEL
&kp C_VOLUME_UP    &commanding     &kp UP    &none      &none   &none   &mkp LCLK       &mmv MOVE_UP    &mkp RCLK          &kp F11  &kp F12  &kp PAGE_UP
&kp C_VOLUME_DOWN  &kp LEFT_ARROW  &kp DOWN  &kp RIGHT  &none   &none   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT    &none    &none    &kp PAGE_DOWN
&kp K_MUTE         &none           &none     &none      &none   &none   &none           &none           &none              &none    &none    &none
&none              &none           &none     &none      &none   &none   &none           &kp LC(MINUS)   &kp LS(LC(MINUS))  &none    &none    &none
                   &none           &none     &none      &none   &none   &none           &none           &none              &none    &none
            >;

            sensor-bindings = <&Scroll_LR>, <&Scroll_LR>;
        };

        raise_layer {
            display-name = "Raise Layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp 0 0>, <&inc_dec_kp 0 0>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp 0 0>, <&inc_dec_kp 0 0>;
        };
    };
};
