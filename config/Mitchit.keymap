#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Combo_CLR_BT {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <11 51 36>;
            layers = <0>;
        };

        open-brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <40 41>;
        };

        close-brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <42 43>;
        };

        open-bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <28 29>;
        };

        close-bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <30 31>;
        };
    };

    macros {
        CommnentLineMac: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(K)>, <&macro_wait_time 100>, <&kp LG(C)>;

            label = "NEW_MACRO";
        };

        SplitFunctionMac: split_function {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(R)>, <&macro_wait_time 100>, <&kp LG(M)>;

            label = "SPLIT_FUNCTION";
        };

        CommnentLineWin: CommnentLineWin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(K)>, <&macro_wait_time 100>, <&kp LC(C)>;

            label = "COMMNENTLINEWIN";
        };

        SplitFunctionWin: SplitFunctionWin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(R)>, <&macro_wait_time 100>, <&kp LC(M)>;

            label = "SPLITFUNCTIONWIN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_layer {
            display-name = "MacOS Layer";
            bindings = <
&kp ESC       &kp N1     &kp N2    &kp N3    &kp N4       &kp N5       &kp N6       &kp N7       &kp N8            &kp N9          &kp N0               &kp BACKSPACE
&kp GRAVE     &kp Q      &kp W     &kp E     &kp R        &kp T        &kp Y        &kp U        &kp I             &kp O           &kp P                &kp DEL
&kp TAB       &kp A      &kp S     &kp D     &kp F        &kp G        &kp H        &kp J        &kp K             &kp L           &kp SEMI             &kp SINGLE_QUOTE
&kp LSHFT     &kp Z      &kp X     &kp C     &kp V        &kp B        &kp N        &kp M        &kp COMMA         &kp DOT         &kp SLASH            &kp RSHFT
&kp CAPSLOCK  &kp LCTRL  &kp LALT  &kp LGUI  &lt 1 SPACE  &lt 1 ENTER  &lt 2 ENTER  &lt 2 K_APP  &mt RGUI MINUS    &mt RALT EQUAL  &mt RCTRL BACKSLASH  &none
              &none      &none     &none     &none        &none        &kp LEFT     &kp DOWN     &kp C_PLAY_PAUSE  &kp UP          &kp RIGHT
            >;

            sensor-bindings = <&Scroll_D_U>;
        };

        lower_layer {
            bindings = <
&trans     &kp F1           &kp F2       &kp F3       &kp F4            &kp F5          &kp F6           &kp F7             &kp F8         &kp F9                &kp F10                &kp F11
&kp GRAVE  &kp N1           &kp N2       &kp N3       &kp N4            &kp N5          &kp N6           &kp N7             &kp N8         &kp N9                &kp N0                 &kp F12
&trans     &kp EXCLAMATION  &kp AT_SIGN  &kp HASH     &kp DOLLAR        &kp PERCENT     &kp CARET        &kp AMPERSAND      &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&trans     &kp EQUAL        &kp MINUS    &kp KP_PLUS  &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp SEMICOLON  &kp COLON             &kp BACKSLASH          &trans
&trans     &trans           &trans       &trans       &trans            &trans          &trans           &trans             &trans         &trans                &trans                 &none
           &none            &none        &none        &none             &none           &none            &kp C_VOL_DN       &kp C_MUTE     &kp C_VOL_UP          &none
            >;

            label = "Lower Layer";
            sensor-bindings = <&Scroll_D_U>;
        };

        raise_layer_mac {
            bindings = <
&trans  &CommnentLineMac  &none              &none      &none      &none   &none          &none              &none       &none            &none   &trans
&none   &none             &SplitFunctionMac  &none      &none      &none   &none          &none              &none       &none            &none   &trans
&trans  &none             &none              &none      &none      &none   &kp PAGE_UP    &kp HOME           &kp UP      &kp END          &none   &none
&trans  &kp LG(Z)         &kp LG(X)          &kp LG(C)  &kp LG(V)  &none   &kp PAGE_DOWN  &kp LEFT           &kp DOWN    &kp RIGHT        &none   &trans
&trans  &trans            &trans             &trans     &trans     &trans  &trans         &trans             &trans      &trans           &trans  &none
        &none             &none              &none      &none      &none   &none          &kp C_VOLUME_DOWN  &kp C_MUTE  &kp C_VOLUME_UP  &none
            >;

            label = "Raise Layer (MAC)";
            sensor-bindings = <&Scroll_D_U>;
        };

        adjust_layer {
            label = "Adjust Layer";
            bindings = <
&bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &to 0   &none   &none   &none   &none   &trans
&trans          &none         &none         &none         &none         &none         &none   &none   &none   &none   &none   &trans
&trans          &none         &none         &none         &none         &none         &none   &none   &none   &none   &none   &none
&trans          &none         &none         &none         &none         &none         &none   &none   &none   &none   &none   &trans
&none           &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &none
                &none         &none         &none         &none         &none         &none   &none   &none   &none   &none
            >;

            sensor-bindings = <&Scroll_D_U>;
        };

        win_layer {
            display-name = "Window Layer";
            bindings = <
&kp ESC       &kp N1    &kp N2    &kp N3     &kp N4       &kp N5       &kp N6       &kp N7       &kp N8            &kp N9          &kp N0              &kp BACKSPACE
&kp GRAVE     &kp Q     &kp W     &kp E      &kp R        &kp T        &kp Y        &kp U        &kp I             &kp O           &kp P               &kp DEL
&kp TAB       &kp A     &kp S     &kp D      &kp F        &kp G        &kp H        &kp J        &kp K             &kp L           &kp SEMI            &kp SINGLE_QUOTE
&kp LSHFT     &kp Z     &kp X     &kp C      &kp V        &kp B        &kp N        &kp M        &kp COMMA         &kp DOT         &kp SLASH           &kp RSHFT
&kp CAPSLOCK  &kp LGUI  &kp LALT  &kp LCTRL  &lt 1 SPACE  &lt 1 ENTER  &lt 5 ENTER  &lt 5 K_APP  &mt RCTRL MINUS   &mt RALT EQUAL  &mt RGUI BACKSLASH  &none
              &none     &none     &none      &none        &none        &kp LEFT     &kp DOWN     &kp C_PLAY_PAUSE  &kp UP          &kp RIGHT
            >;

            sensor-bindings = <&Scroll_D_U>;
        };

        raise_layer_win {
            label = "Raise Layer (Wind)";
            bindings = <
&trans  &CommnentLineWin  &none              &none      &none      &none   &none          &none              &none       &none            &none   &trans
&none   &none             &SplitFunctionWin  &none      &none      &none   &none          &none              &none       &none            &none   &trans
&trans  &none             &none              &none      &none      &none   &kp PAGE_UP    &kp HOME           &kp UP      &kp END          &none   &none
&trans  &kp LG(Z)         &kp LG(X)          &kp LG(C)  &kp LG(V)  &none   &kp PAGE_DOWN  &kp LEFT           &kp DOWN    &kp RIGHT        &none   &trans
&trans  &trans            &trans             &trans     &trans     &trans  &trans         &trans             &trans      &trans           &trans  &none
        &none             &none              &none      &none      &none   &none          &kp C_VOLUME_DOWN  &kp C_MUTE  &kp C_VOLUME_UP  &none
            >;

            sensor-bindings = <&Scroll_D_U>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Mac-2-Adjust {
            if-layers = <1 2>;
            then-layer = <3>;
        };

        Window-2-Adjust {
            if-layers = <5 1>;
            then-layer = <3>;
        };
    };
};
