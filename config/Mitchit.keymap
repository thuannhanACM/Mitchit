#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };
    };

    combos {
        compatible = "zmk,combos";

        open-brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <28 29>;
            layers = <0 4 1 3>;
        };

        close-brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <30 31>;
            layers = <0 4 1 3>;
        };

        open-bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <40 41>;
            layers = <0 4 1 3>;
        };

        close-bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <42 43>;
            layers = <0 4 1 3>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <54 55>;
            layers = <0 4 1 3>;
        };

        minus {
            bindings = <&kp KP_MINUS>;
            key-positions = <55 56>;
            layers = <0 4 1 3>;
        };

        multiply {
            bindings = <&kp KP_MULTIPLY>;
            key-positions = <56 57>;
            layers = <0 4 1 3>;
        };

        divide {
            bindings = <&kp KP_DIVIDE>;
            key-positions = <57 58>;
            layers = <0 4 1 3>;
        };
    };

    macros {
        CommnentLineMac: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(K)>, <&macro_wait_time 100>, <&kp LG(C)>;

            label = "NEW_MACRO";
        };

        SplitFunctionMac: split_function {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(R)>, <&macro_wait_time 100>, <&kp LG(M)>;

            label = "SPLIT_FUNCTION";
        };

        CommnentLineWin: CommnentLineWin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(K)>, <&macro_wait_time 100>, <&kp LC(C)>;

            label = "COMMNENTLINEWIN";
        };

        SplitFunctionWin: SplitFunctionWin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(R)>, <&macro_wait_time 100>, <&kp LC(M)>;

            label = "SPLITFUNCTIONWIN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_layer {
            display-name = "MacOS Layer";
            bindings = <
&kp ESC       &kp N1     &kp N2    &kp N3    &kp N4           &kp N5       &kp N6       &kp N7       &kp N8            &kp N9                 &kp N0                   &kp BACKSPACE
&lt 4 GRAVE   &kp Q      &kp W     &kp E     &kp R            &kp T        &kp Y        &kp U        &kp I             &kp O                  &kp P                    &kp BACKSLASH
&kp TAB       &kp A      &kp S     &kp D     &kp F            &kp G        &kp H        &kp J        &kp K             &kp L                  &kp SEMI                 &kp SINGLE_QUOTE
&kp LSHFT     &kp Z      &kp X     &kp C     &kp V            &kp B        &kp N        &kp M        &kp COMMA         &kp DOT                &kp SLASH                &mt RSHFT ENTER
&kp CAPSLOCK  &kp LCTRL  &kp LALT  &kp LGUI  &lt 1 LG(SPACE)  &lt 1 SPACE  &lt 1 ENTER  &lt 1 MINUS  &mt RGUI EQUAL    &mt RALT LEFT_BRACKET  &mt RCTRL RIGHT_BRACKET  &none
              &none      &none     &none     &none            &none        &kp LEFT     &kp DOWN     &kp C_PLAY_PAUSE  &kp UP                 &kp RIGHT
            >;

            sensor-bindings = <&Scroll_D_U>;
        };

        raise_layer_mac {
            bindings = <
&trans  &kp F1            &kp F2             &kp F3     &kp F4     &kp F5     &kp F6         &kp F7             &kp F8      &kp F9           &kp F10  &kp DEL
&none   &CommnentLineMac  &SplitFunctionMac  &none      &none      &none      &kp PAGE_UP    &kp LG(LEFT)       &kp UP      &kp LG(RIGHT)    &kp F11  &kp LS(F11)
&trans  &kp LG(A)         &kp LG(S)          &kp LG(D)  &kp LG(F)  &kp LG(G)  &kp PAGE_DOWN  &kp LEFT           &kp DOWN    &kp RIGHT        &kp F12  &kp LS(F12)
&trans  &kp LG(Z)         &kp LG(X)          &kp LG(C)  &kp LG(V)  &none      &none          &kp LA(LEFT)       &none       &kp LA(RIGHT)    &none    &trans
&trans  &trans            &trans             &trans     &trans     &trans     &trans         &trans             &trans      &trans           &trans   &none
        &none             &none              &none      &none      &none      &none          &kp C_VOLUME_DOWN  &kp C_MUTE  &kp C_VOLUME_UP  &none
            >;

            label = "Raise Layer (MAC)";
            sensor-bindings = <&Scroll_D_U>;
        };

        window_layer {
            display-name = "Window Layer";
            bindings = <
&kp ESC       &kp N1    &kp N2    &kp N3     &kp N4       &kp N5       &kp N6       &kp N7       &kp N8            &kp N9                 &kp N0                  &kp BACKSPACE
&lt 4 GRAVE   &kp Q     &kp W     &kp E      &kp R        &kp T        &kp Y        &kp U        &kp I             &kp O                  &kp P                   &kp BACKSLASH
&kp TAB       &kp A     &kp S     &kp D      &kp F        &kp G        &kp H        &kp J        &kp K             &kp L                  &kp SEMI                &kp SINGLE_QUOTE
&kp LSHFT     &kp Z     &kp X     &kp C      &kp V        &kp B        &kp N        &kp M        &kp COMMA         &kp DOT                &kp SLASH               &mt RSHFT ENTER
&kp CAPSLOCK  &kp LGUI  &kp LALT  &kp LCTRL  &lt 3 SPACE  &lt 3 SPACE  &lt 3 ENTER  &lt 3 MINUS  &mt RCTRL EQUAL   &mt RALT LEFT_BRACKET  &mt RGUI RIGHT_BRACKET  &none
              &none     &none     &none      &none        &none        &kp LEFT     &kp DOWN     &kp C_PLAY_PAUSE  &kp UP                 &kp RIGHT
            >;

            sensor-bindings = <&Scroll_D_U>;
        };

        raise_layer_window {
            label = "Raise Layer (Window)";
            bindings = <
&trans  &kp F1            &kp F2             &kp F3     &kp F4     &kp F5     &kp F6         &kp F7             &kp F8      &kp F9           &kp F10  &kp DEL
&none   &CommnentLineWin  &SplitFunctionWin  &none      &none      &none      &kp PAGE_UP    &kp HOME           &kp UP      &kp END          &kp F11  &kp LS(F11)
&trans  &kp LC(A)         &kp LC(S)          &kp LC(D)  &kp LC(F)  &kp LC(G)  &kp PAGE_DOWN  &kp LEFT           &kp DOWN    &kp RIGHT        &kp F12  &kp LS(F12)
&trans  &kp LC(Z)         &kp LC(X)          &kp LC(C)  &kp LC(V)  &none      &none          &kp LC(LEFT)       &none       &kp LC(RIGHT)    &none    &trans
&trans  &trans            &trans             &trans     &trans     &trans     &trans         &trans             &trans      &trans           &trans   &none
        &none             &none              &none      &none      &none      &none          &kp C_VOLUME_DOWN  &kp C_MUTE  &kp C_VOLUME_UP  &none
            >;

            sensor-bindings = <&Scroll_D_U>;
        };

        adjust_layer {
            label = "Adjust Layer";
            bindings = <
&bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &to 0   &to 2   &none   &none   &none   &trans
&trans          &none         &none         &none         &none         &none         &none   &none   &none   &none   &none   &trans
&trans          &none         &none         &none         &none         &none         &none   &none   &none   &none   &none   &none
&trans          &none         &none         &none         &none         &none         &none   &none   &none   &none   &none   &trans
&none           &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &none
                &none         &none         &none         &none         &none         &none   &none   &none   &none   &none
            >;

            sensor-bindings = <&Scroll_D_U>;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
