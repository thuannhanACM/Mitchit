#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Combo_CLR_BT {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <0 52 41>;
            layers = <2 0>;
        };

        to-window {
            bindings = <&to 1>;
            key-positions = <52 14 33>;
            layers = <0>;
        };

        to-mac {
            bindings = <&to 0>;
            key-positions = <52 33 43>;
            layers = <1>;
        };

        bluetooth-0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <41 52 1>;
            layers = <0 1 2>;
        };

        bluetoot-1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <41 52 2>;
            layers = <0 1 2>;
        };
    };

    macros {
        commanding: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(K)>, <&macro_wait_time 100>, <&kp LG(C)>;

            label = "NEW_MACRO";
        };

        extract_method: split_function {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(R)>, <&macro_wait_time 100>, <&kp LG(M)>;

            label = "SPLIT_FUNCTION";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Mac {
            display-name = "Mac Layer";
            bindings = <
&kp ESC     &kp N1    &kp N2        &kp N3     &kp N4        &kp N5     &kp N6     &kp N7     &kp N8     &kp N9            &kp N0             &kp BSPC
&kp TAB     &kp Q     &kp W         &kp E      &kp R         &kp T      &kp Y      &kp U      &kp I      &kp O             &kp P              &kp ENTER
&kp LSHIFT  &kp A     &kp S         &kp D      &kp F         &kp G      &kp H      &kp J      &kp K      &kp L             &kp SEMI           &kp SQT
&kp LGUI    &kp Z     &kp X         &kp C      &kp V         &kp B      &kp N      &kp M      &kp COMMA  &kp DOT           &kp FSLH           &none
&none       &kp CAPS  &kp LEFT_ALT  &kp LCTRL  &lt 2 DELETE  &kp SPACE  &kp SPACE  &kp MINUS  &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none
            &kp LEFT  &kp UP        &none      &kp DOWN      &kp RIGHT  &kp LEFT   &kp DOWN   &none      &kp UP            &kp RIGHT
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_D_U>;
        };

        Wins {
            display-name = "Window Layer";
            bindings = <
&kp ESC     &kp N1    &kp N2    &kp N3    &kp N4        &kp N5     &kp N6     &kp N7     &kp N8     &kp N9            &kp N0             &kp BSPC
&kp TAB     &kp Q     &kp W     &kp E     &kp R         &kp T      &kp Y      &kp U      &kp I      &kp O             &kp P              &kp ENTER
&kp LSHIFT  &kp A     &kp S     &kp D     &kp F         &kp G      &kp H      &kp J      &kp K      &kp L             &kp SEMI           &kp SQT
&kp LCTRL   &kp Z     &kp X     &kp C     &kp V         &kp B      &kp N      &kp M      &kp COMMA  &kp DOT           &kp FSLH           &none
&none       &kp CAPS  &kp LGUI  &kp LALT  &lt 2 DELETE  &kp SPACE  &kp SPACE  &kp MINUS  &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none
            &kp LEFT  &kp UP    &none     &kp DOWN      &kp RIGHT  &kp LEFT   &kp DOWN   &none      &kp UP            &kp RIGHT
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_D_U>;
        };

        function-layer {
            display-name = "Lower Layer";
            bindings = <
&kp GRAVE  &kp F1          &kp F2    &kp F3     &kp F4  &kp F5     &kp F6          &kp F7             &kp F8             &kp F9           &kp F10      &kp F11
&trans     &none           &kp UP    &none      &none   &kp PG_UP  &mkp LCLK       &mmv MOVE_UP       &mkp RCLK          &none            &none        &kp F12
&trans     &kp LEFT_ARROW  &kp DOWN  &kp RIGHT  &none   &kp PG_DN  &mmv MOVE_LEFT  &mmv MOVE_DOWN     &mmv MOVE_RIGHT    &none            &none        &none
&trans     &none           &none     &none      &none   &none      &none           &none              &none              &none            &commanding  &extract_method
&none      &none           &trans    &trans     &none   &trans     &trans          &kp LG(MINUS)      &kp LS(LG(MINUS))  &none            &none        &none
           &none           &none     &none      &none   &none      &none           &kp C_VOLUME_DOWN  &kp K_MUTE         &kp C_VOLUME_UP  &none
            >;

            sensor-bindings = <&Scroll_LR>, <&Scroll_LR>;
        };
    };
};
