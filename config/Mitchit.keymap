#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };

        td_Bracket: td_Bracket {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BRACKET";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;
        };

        td_Parenthesis: td_Parenthesis {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_PARENTHESIS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        td_BRACE: td_BRACE {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BRACE";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;
        };

        td_F5: td_F5 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_F5";
            #binding-cells = <0>;
            bindings = <&kp F5>, <&kp LS(F5)>;
        };

        td_F11: td_F11 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_F11";
            #binding-cells = <0>;
            bindings = <&kp F11>, <&kp LS(F11)>;
        };

        td_F12: td_F12 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_F12";
            #binding-cells = <0>;
            bindings = <&kp F12>, <&kp LS(F12)>;
        };
    };

    combos { compatible = "zmk,combos"; };

    macros {
        CommnentLineMac: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(K)>, <&macro_wait_time 100>, <&kp LG(C)>;

            label = "NEW_MACRO";
        };

        SplitFunctionMac: split_function {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(R)>, <&macro_wait_time 100>, <&kp LG(M)>;

            label = "SPLIT_FUNCTION";
        };

        CommnentLineWin: CommnentLineWin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(K)>, <&macro_wait_time 100>, <&kp LC(C)>;

            label = "COMMNENTLINEWIN";
        };

        SplitFunctionWin: SplitFunctionWin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(R)>, <&macro_wait_time 100>, <&kp LC(M)>;

            label = "SPLITFUNCTIONWIN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            display-name = "Default";
            bindings = <
&kp ESC           &kp N1         &kp N2        &kp N3  &kp N4            &kp N5       &kp N6      &kp N7                &kp N8            &kp N9             &kp N0     &mt LC(BACKSPACE) BACKSPACE
&kp TAB           &kp Q          &kp W         &kp E   &kp R             &kp T        &kp Y       &kp U                 &kp I             &kp O              &kp APOS   &kp BACKSLASH
&kp LEFT_CONTROL  &kp A          &kp S         &kp D   &kp F             &kp G        &kp H       &kp J                 &kp K             &kp L              &kp P      &kp SEMICOLON
&kp LEFT_SHIFT    &kp Z          &kp X         &kp C   &kp V             &kp B        &kp N       &kp M                 &kp COMMA         &kp DOT            &kp FSLH   &kp RSHFT
&none             &kp LEFT_META  &kp LEFT_ALT  &mo 1   &mt LSHIFT SPACE  &lt 2 ENTER  &kp RETURN  &mt RSHIFT BACKSPACE  &mo 3             &mt RALT CAPSLOCK  &kp RCTRL  &none
                  &none          &none         &none   &none             &none        &kp LEFT    &kp DOWN              &kp C_PLAY_PAUSE  &kp UP             &kp RIGHT
            >;

            sensor-bindings = <&Scroll_D_U>;
        };

        lower {
            bindings = <
&trans  &kp F1           &kp F2  &kp F3  &kp F4     &kp F5           &kp F6          &kp F7                       &kp F8           &kp F9           &kp F10    &trans
&trans  &kp EXCLAMATION  &kp N7  &kp N8  &kp N9     &kp DOLLAR       &kp CARET       &kp MINUS                    &td_Parenthesis  &kp ASTRK        &kp GRAVE  &kp F11
&trans  &kp AT_SIGN      &kp N4  &kp N5  &kp N6     &kp N0           &kp AMPERSAND   &kp PLUS                     &td_BRACE        &kp SLASH        &kp TILDE  &kp F12
&trans  &kp HASH         &kp N1  &kp N2  &kp N3     &kp PERCENT      &kp UNDERSCORE  &kp EQUAL                    &td_Bracket      &none            &none      &trans
&trans  &trans           &trans  &none   &kp SPACE  &mt LC(DEL) DEL  &kp ENTER       &mt LC(BACKSPACE) BACKSPACE  &none            &trans           &trans     &none
        &none            &none   &none   &none      &none            &none           &kp C_VOLUME_DOWN            &kp C_MUTE       &kp C_VOLUME_UP  &none
            >;

            label = "Lower Layer";
            sensor-bindings = <&Scroll_D_U>;
        };

        debug {
            label = "Debug Layer";
            bindings = <
&trans  &none   &none   &none   &none    &none    &none  &none     &none     &none      &none  &none
&trans  &kp F1  &kp F2  &kp F3  &kp F4   &td_F5   &none  &none     &kp UP    &none      &none  &none
&none   &kp F6  &kp F7  &kp F8  &kp F9   &kp F10  &none  &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none
&trans  &none   &none   &none   &td_F11  &td_F12  &none  &none     &none     &none      &none  &trans
&none   &none   &none   &none   &none    &none    &none  &none     &none     &none      &none  &none
        &none   &none   &none   &none    &none    &none  &none     &none     &none      &none
            >;

            sensor-bindings = <&Scroll_D_U>;
        };

        adjust {
            label = "Adjust Layer";
            bindings = <
&none  &none           &none  &none  &none  &none  &none  &none  &none  &none         &none         &bt BT_CLR
&none  &none           &none  &none  &none  &none  &none  &none  &none  &none         &none         &none
&none  &none           &none  &none  &none  &none  &none  &none  &none  &none         &none         &none
&none  &none           &none  &none  &none  &none  &none  &none  &none  &none         &none         &bt BT_SEL 1
&none  &bt BT_CLR_ALL  &none  &none  &none  &none  &none  &none  &none  &bt BT_SEL 0  &bt BT_SEL 2  &none
       &none           &none  &none  &none  &none  &none  &none  &none  &none         &none
            >;

            sensor-bindings = <&Scroll_D_U>;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
