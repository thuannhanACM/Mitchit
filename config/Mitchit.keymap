#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };

        td_LBracket_Parenthesis: td_LBracket_Parenthesis {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LBRACKET_PARENTHESIS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp LEFT_PARENTHESIS>;
        };

        td_RBracket_Parenthesi: td_RBracket_Parenthesi {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_RBRACKET_PARENTHESI";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACKET>, <&kp RIGHT_PARENTHESIS>;
        };

        td_9_0: td_9_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_9_0";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp N0>;
        };

        td_0_9: td_0_9 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_0_9";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp N9>;
        };

        td_equal_copy: td_equal_copy {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_EQUAL_COPY";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp LG(C)>;
        };

        td_backslash_paste: td_backslash_paste {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BACKSLASH_PASTE";
            #binding-cells = <0>;
            bindings = <&kp BACKSLASH>, <&kp LG(V)>;
        };
    };

    combos { compatible = "zmk,combos"; };

    macros {
        CommnentLineMac: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(K)>, <&macro_wait_time 100>, <&kp LG(C)>;

            label = "NEW_MACRO";
        };

        SplitFunctionMac: split_function {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(R)>, <&macro_wait_time 100>, <&kp LG(M)>;

            label = "SPLIT_FUNCTION";
        };

        CommnentLineWin: CommnentLineWin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(K)>, <&macro_wait_time 100>, <&kp LC(C)>;

            label = "COMMNENTLINEWIN";
        };

        SplitFunctionWin: SplitFunctionWin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(R)>, <&macro_wait_time 100>, <&kp LC(M)>;

            label = "SPLITFUNCTIONWIN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_layer {
            display-name = "MacOS Layer";
            bindings = <
&kp ESC       &kp Q     &kp W      &kp E        &kp R        &kp T                     &kp Y                    &kp U        &kp I             &kp O                &kp P          &kp BSPC
&kp TAB       &kp A     &kp S      &kp D        &kp F        &kp G                     &kp H                    &kp J        &kp K             &kp L                &kp SEMICOLON  &kp ENTER
&kp LSHFT     &kp Z     &kp X      &kp C        &kp V        &kp B                     &kp N                    &kp M        &kp COMMA         &kp DOT              &kp UP         &mt RSHIFT SLASH
&kp LGUI      &kp LALT  &kp F10    &kp F11      &kp F12      &td_LBracket_Parenthesis  &td_RBracket_Parenthesi  &kp MINUS    &kp SINGLE_QUOTE  &kp LEFT             &kp DOWN       &kp RIGHT
&kp CAPSLOCK  &mo 2     &kp LCTRL  &lt 1 GRAVE  &lt 1 SPACE  &lt 1 ENTER               &lt 1 DEL                &lt 1 SPACE  &td_equal_copy    &td_backslash_paste  &mo 2          &none
              &none     &none      &none        &none        &none                     &kp LEFT                 &kp DOWN     &kp C_PLAY_PAUSE  &kp UP               &kp RIGHT
            >;

            sensor-bindings = <&Scroll_D_U>;
        };

        raise_layer_mac {
            bindings = <
&trans  &CommnentLineMac  &SplitFunctionMac  &none    &none    &none              &kp N7             &kp N8             &td_9_0     &kp KP_PLUS      &kp KP_MINUS   &trans
&trans  &kp F1            &kp F2             &kp F3   &kp F4   &none              &kp N4             &kp N5             &kp N6      &kp KP_MULTIPLY  &kp KP_DIVIDE  &trans
&trans  &kp F5            &kp F6             &kp F7   &kp F8   &kp LS(LG(MINUS))  &kp N1             &kp N2             &kp N3      &kp LG(LEFT)     &kp PAGE_UP    &kp LG(RIGHT)
&trans  &kp F9            &kp F10            &kp F11  &kp F12  &kp LG(MINUS)      &kp LG(LS(MINUS))  &td_0_9            &kp DOT     &kp LA(LEFT)     &kp PAGE_DOWN  &kp LA(RIGHT)
&trans  &trans            &trans             &trans   &trans   &trans             &trans             &trans             &kp LG(C)   &kp LG(V)        &trans         &none
        &none             &none              &none    &none    &none              &none              &kp C_VOLUME_DOWN  &kp C_MUTE  &kp C_VOLUME_UP  &none
            >;

            label = "Raise Layer (MAC)";
            sensor-bindings = <&Scroll_D_U>;
        };

        adjust_layer {
            label = "Adjust Layer";
            bindings = <
&bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &to 0  &to 0  &none  &none  &none  &bt BT_CLR
&none           &none         &none         &none         &none         &none         &none  &none  &none  &none  &none  &none
&none           &none         &none         &none         &none         &none         &none  &none  &none  &none  &none  &none
&none           &none         &none         &none         &none         &none         &none  &none  &none  &none  &none  &none
&none           &none         &none         &none         &none         &none         &none  &none  &none  &none  &none  &none
                &none         &none         &none         &none         &none         &none  &none  &none  &none  &none
            >;

            sensor-bindings = <&Scroll_D_U>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Mac-2-Adjust {
            if-layers = <2 1>;
            then-layer = <2>;
        };

        Window-2-Adjust {
            if-layers = <2 2>;
            then-layer = <2>;
        };
    };
};
