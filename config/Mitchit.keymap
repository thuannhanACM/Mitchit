#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Combo_CLR_BT {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <11 51 36>;
            layers = <2 0 3 1>;
        };

        to-window {
            bindings = <&to 2>;
            key-positions = <51 2 0>;
        };

        to-mac {
            bindings = <&to 0>;
            key-positions = <51 0 1>;
            layers = <2>;
        };

        bluetooth-0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <51 1 36>;
            layers = <2 3 0 1>;
        };

        bluetoot-1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <51 2 36>;
            layers = <2 0 3 1>;
        };

        bluetooth-clear-current {
            bindings = <&bt BT_CLR>;
            key-positions = <51 36 47>;
        };

        open-brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <17 16>;
        };

        close-brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <18 19>;
        };

        open-bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <28 29>;
        };

        close-bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <30 31>;
        };
    };

    macros {
        commanding: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(K)>, <&macro_wait_time 100>, <&kp LG(C)>;

            label = "NEW_MACRO";
        };

        extract_method: split_function {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(R)>, <&macro_wait_time 100>, <&kp LG(M)>;

            label = "SPLIT_FUNCTION";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac-layer {
            display-name = "MacOS Layer";
            bindings = <
&kp ESCAPE    &kp N1     &kp N2    &kp N3    &kp N4       &kp N5       &kp N6       &kp N7          &kp N8            &kp N9          &kp N0           &kp BACKSPACE
&kp GRAVE     &kp Q      &kp W     &kp E     &kp R        &kp T        &kp Y        &kp U           &kp I             &kp O           &kp P            &kp MINUS
&kp TAB       &kp A      &kp S     &kp D     &kp F        &kp G        &kp H        &kp J           &kp K             &kp L           &kp SEMI         &mt RSHFT EQUAL
&kp LSHFT     &kp Z      &kp X     &kp C     &kp V        &kp B        &kp N        &kp M           &kp COMMA         &kp DOT         &kp FSLH         &mt RCMD ENTER
&kp CAPSLOCK  &kp LCTRL  &kp LALT  &kp LGUI  &lt 1 ENTER  &lt 1 SPACE  &lt 1 SPACE  &kp LEFT_ARROW  &kp UP_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW  &none
              &none      &none     &none     &none        &none        &kp LEFT     &kp DOWN        &kp C_PLAY_PAUSE  &kp UP          &kp RIGHT
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_D_U>;
        };

        mac-function-layer {
            display-name = "MacOS Functions";
            bindings = <
&trans  &kp F1       &kp F2           &kp F3  &kp F4         &kp F5             &kp F6            &kp F7             &kp F8           &kp F9            &kp F10            &kp DEL
&none   &commanding  &extract_method  &none   &kp LG(MINUS)  &kp LG(LS(MINUS))  &mkp LCLK         &mmv MOVE_UP       &mkp RCLK        &kp BACKSLASH     &kp PIPE           &none
&trans  &none        &none            &none   &kp F11        &kp F12            &mmv MOVE_LEFT    &mmv MOVE_DOWN     &mmv MOVE_RIGHT  &kp LEFT_BRACE    &kp RIGHT_BRACE    &trans
&trans  &none        &none            &none   &kp LS(F11)    &kp LS(F12)        &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &none            &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&trans  &trans       &trans           &trans  &trans         &trans             &none             &kp HOME           &kp END          &kp PAGE_UP       &kp PAGE_DOWN      &none
        &none        &none            &none   &none          &none              &none             &kp C_VOLUME_DOWN  &kp K_MUTE       &kp C_VOLUME_UP   &none
            >;

            sensor-bindings = <&Scroll_LR>, <&Scroll_LR>;
        };

        Wins {
            display-name = "Window Layer";
            bindings = <
&kp ESCAPE    &kp N1    &kp N2    &kp N3     &kp N4       &kp N5       &kp N6       &kp N7          &kp N8            &kp N9          &kp N0           &kp BACKSPACE
&kp GRAVE     &kp Q     &kp W     &kp E      &kp R        &kp T        &kp Y        &kp U           &kp I             &kp O           &kp P            &kp MINUS
&kp TAB       &kp A     &kp S     &kp D      &kp F        &kp G        &kp H        &kp J           &kp K             &kp L           &kp SEMI         &mt RSHFT EQUAL
&kp LSHIFT    &kp Z     &kp X     &kp C      &kp V        &kp B        &kp N        &kp M           &kp COMMA         &kp DOT         &kp FSLH         &mt RCTRL ENTER
&kp CAPSLOCK  &kp LCMD  &kp LALT  &kp LCTRL  &lt 3 ENTER  &lt 3 SPACE  &lt 3 SPACE  &kp LEFT_ARROW  &kp UP_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW  &none
              &none     &none     &none      &none        &none        &kp LEFT     &kp DOWN        &kp C_PLAY_PAUSE  &kp UP          &kp RIGHT
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_D_U>;
        };

        win-functions-layer {
            display-name = "Window Functions";
            bindings = <
&trans  &kp F1       &kp F2           &kp F3  &kp F4         &kp F5             &kp F6            &kp F7             &kp F8           &kp F9            &kp F10            &kp DELETE
&none   &commanding  &extract_method  &none   &kp LC(MINUS)  &kp LC(LS(MINUS))  &mkp LCLK         &mmv MOVE_UP       &mkp RCLK        &kp BACKSLASH     &kp PIPE           &none
&trans  &none        &none            &none   &kp F11        &kp F12            &mmv MOVE_LEFT    &mmv MOVE_DOWN     &mmv MOVE_RIGHT  &kp LEFT_BRACE    &kp RIGHT_BRACE    &trans
&trans  &none        &none            &none   &kp LS(F11)    &kp LS(F12)        &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &none            &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&trans  &trans       &trans           &trans  &trans         &trans             &none             &kp HOME           &kp END          &kp PAGE_UP       &kp PAGE_DOWN      &none
        &none        &none            &none   &none          &none              &none             &kp C_VOLUME_DOWN  &kp K_MUTE       &kp C_VOLUME_UP   &none
            >;

            sensor-bindings = <&Scroll_LR>, <&Scroll_LR>;
        };
    };
};
